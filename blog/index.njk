<!DOCTYPE html>
<html lang="en-US">
<head>
{% include "gtag.njk" %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ site.url }}{% if pagination.pageNumber == 0 %}/blog/{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/{% endif %}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} — Blog" href="{{ site.url }}/feed.xml">
  <title>Blog — {{ site.name }} | Medicare Enrollment Software for Agents</title>
  <meta name="description" content="Insights, tips, and guides for licensed Medicare agents. From enrollment best practices to growing your book of business — by myMA.">
  <meta property="og:title" content="Blog — {{ site.name }}">
  <meta property="og:description" content="Insights, tips, and guides for licensed Medicare agents.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}/blog/">
  <meta name="twitter:card" content="summary">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/blog.css">
</head>
<body>

{% include "header.njk" %}

<div class="inner">
  <div class="eyebrow">For Licensed Medicare Agents</div>
  <h1>The myMA <span style="color:var(--sky)">Blog</span></h1>
  <p class="sub">Insights, tips, and guides to help you enrol more clients and grow your book of business.</p>
</div>
</section>

<section class="sec">
  <div class="blog-grid">
    {% for post in pagedPosts %}
    {% if post %}
    <article class="blog-card fade-in">
      <a href="{{ post.url }}" class="blog-card-full-link" aria-labelledby="blog-card-title-{{ pagination.pageNumber }}-{{ loop.index }}">
        <div class="blog-thumb">
          {% if post.data.featured_image %}
          <img src="{{ post.data.featured_image }}" alt="" class="blog-thumb-image">
          {% else %}
          <span aria-hidden="true">{{ post.data.hero_emoji or "📋" }}</span>
          {% endif %}
        </div>
        <div class="blog-card-body">
          <div class="blog-date">{{ post.date | postDate }}</div>
          <h3 id="blog-card-title-{{ pagination.pageNumber }}-{{ loop.index }}">{{ post.data.title }}</h3>
          <span class="card-link">Read More →</span>
        </div>
      </a>
    </article>
    {% endif %}
    {% endfor %}
  </div>

  {% if pagination.pages.length > 1 %}
  <nav class="pagination-nav" aria-label="Blog pagination">
    {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}" class="pagination-link pagination-prev">Prev</a>
    {% else %}
    <span class="pagination-link pagination-prev pagination-disabled" aria-disabled="true">Prev</span>
    {% endif %}

    <div class="pagination-pages">
      {% for entry in pagination.hrefs %}
      <a
        href="{{ entry }}"
        class="pagination-link pagination-page {% if loop.index0 == pagination.pageNumber %}pagination-active{% endif %}"
        {% if loop.index0 == pagination.pageNumber %}aria-current="page"{% endif %}
      >
        {{ loop.index }}
      </a>
      {% endfor %}
    </div>

    {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}" class="pagination-link pagination-next">Next</a>
    {% else %}
    <span class="pagination-link pagination-next pagination-disabled" aria-disabled="true">Next</span>
    {% endif %}
  </nav>
  {% endif %}

  <div class="blog-cta-strip">
    <h3>Ready to modernise your Medicare practice?</h3>
    <p>Give your clients a branded online path to compare and enrol in Medicare Advantage plans.</p>
    <a href="https://host.safemsngr.com/widget/booking/W1VjLO4rMj2floM0U6Gv" class="btn btn-sky">Book a Demo</a>
  </div>
</section>

{% include "footer.njk" %}

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>
</body>
</html>
